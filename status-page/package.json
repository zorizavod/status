{
  "name": "zolotenkov-status-page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-data.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "biome check src scripts tests && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@playwright/test": "1.62.1",
    "@biomejs/biome": "2.5.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
